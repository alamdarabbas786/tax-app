{
  "name": "airport-taxi/backend",
  "description": "Airport taxi platform backend (PHP)",
  "type": "project",
  "require": {
    "php": ">=8.0",
    "vlucas/phpdotenv": "^5.6",
    "predis/predis": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S 0.0.0.0:3000 -t public public/router.php",
    "test": "phpunit -c phpunit.xml --testsuite unit",
    "test:integration": "phpunit -c phpunit.xml --testsuite integration",
    "test:integration:strict": "phpunit -c phpunit.integration.strict.xml --testsuite integration",
    "test:all": "phpunit -c phpunit.xml"
  }
}
