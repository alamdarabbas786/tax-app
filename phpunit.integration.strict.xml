<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php"
         colors="true"
         verbose="true"
         failOnWarning="true">
  <testsuites>
    <testsuite name="integration">
      <directory suffix="Test.php">tests/Integration</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="TEST_BASE_URL" value="http://localhost:3000"/>
    <env name="INTEGRATION_STRICT" value="1"/>
  </php>
</phpunit>


